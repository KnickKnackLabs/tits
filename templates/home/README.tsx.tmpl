import { existsSync, readdirSync } from "fs";
import { join, resolve } from "path";
import {
  Badge, Badges, Bold, Center, Code, CodeBlock, Heading, LineBreak,
  List, Item, Paragraph, Section,
} from "readme/src/components";

const HOME_DIR = resolve(import.meta.dirname);
const tasksDir = join(HOME_DIR, ".mise/tasks");

function countTasks(dir: string): number {
  if (!existsSync(dir)) return 0;
  let count = 0;
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.name.startsWith(".")) continue;
    const path = join(dir, entry.name);
    if (entry.isDirectory()) count += countTasks(path);
    else count += 1;
  }
  return count;
}

const taskCount = countTasks(tasksDir);

const readme = (
  <>
    <Center>
      <Heading level={1}>{{AGENT}}</Heading>
      <Paragraph><Bold>Agent home for {{AGENT}}.</Bold></Paragraph>
      <Badges>
        <Badge label="agent" value="{{AGENT}}" color="blue" />
        <Badge label="tasks" value={`${taskCount}`} color="brightgreen" />
        <Badge label="generated by" value="tits" color="4a4a4a" />
      </Badges>
    </Center>

    <LineBreak />

    <Section title="Wake locally">
      <CodeBlock lang="bash">{`eval "$(shimmer as {{AGENT}})"
export CHAT_IDENTITY='{{AGENT}}'
cd ~/agents/{{AGENT}}/home
mise welcome
shimmer agent`}</CodeBlock>
    </Section>

    <Section title="What this home exposes">
      <List>
        <Item><Code>mise welcome</Code>{" — orient at session start"}</Item>
        <Item><Code>mise run self</Code>{" — local self-session placeholder"}</Item>
        <Item><Code>mise run agent:list</Code>{" — machine-readable supported agent list"}</Item>
        <Item><Code>mise run agent:identity {{AGENT}}</Code>{" — identity content for shimmer"}</Item>
        <Item><Code>mise run agent:prepare</Code>{" — idempotent CI preparation hook"}</Item>
        <Item><Code>mise run human</Code>{" — print HUMAN.md path when available"}</Item>
      </List>
    </Section>

    <Section title="Customize next">
      <List>
        <Item>{"Replace the generated identity in "}<Code>CLAUDE.md</Code></Item>
        <Item>{"Keep continuity in "}<Code>notes/status.md</Code></Item>
        <Item>{"Edit this "}<Code>README.tsx</Code>{" and run "}<Code>readme build</Code></Item>
        <Item>{"Regenerate workflow YAML with "}<Code>shimmer workflows:generate</Code>{" after changing agent-list behavior"}</Item>
      </List>
    </Section>

    <Section title="Generated files">
      <Paragraph>
        {"Workflow YAML under "}<Code>.github/workflows/</Code>{" is generated by shimmer. Treat "}<Code>README.tsx</Code>{" as the source for this README, and generated workflow YAML as an output."}
      </Paragraph>
    </Section>
  </>
);

